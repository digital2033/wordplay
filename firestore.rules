rules_version = '2';

// Shared leaderboard. Each entry is scores/<browserId>_<playerId>.
// Anyone can read the top scores. Only the owner of an entry can write it, and only valid fields.
service cloud.firestore {
  match /databases/{database}/documents {

    match /scores/{docId} {
      allow read: if true;

      allow create, update: if request.auth != null
        && docId.matches(request.auth.uid + '_.*')
        && request.resource.data.keys().hasOnly(['nickname', 'points', 'level', 'games', 'updated'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2
        && request.resource.data.nickname.size() <= 20
        && request.resource.data.points is int
        && request.resource.data.points >= 0
        && request.resource.data.points <= 1000000
        && request.resource.data.games is int
        && request.resource.data.games >= 0
        && request.resource.data.games <= 100000
        && request.resource.data.level is string
        && request.resource.data.level.size() <= 40
        && request.resource.data.updated == request.time;

      allow delete: if request.auth != null
        && docId.matches(request.auth.uid + '_.*');
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
