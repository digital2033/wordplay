# Copy this file to .env and fill in your own values.
# Never commit .env to version control or publish it.

# Your Bible Brain developer key (keep secret)
BIBLE_BRAIN_KEY=your_key_here

# Bible Brain API base (default shown)
BIBLE_BRAIN_BASE=https://4.dbt.io/api

# Filesets the games are allowed to request (comma separated)
# Replace these placeholder IDs with the filesets in your account
ALLOWED_FILESETS=ENGKJVO1DA,ENGKJVN2DA

# Game origins allowed to call this server from a browser (comma separated)
ALLOWED_ORIGINS=https://wordplay.example.org

PORT=8080
